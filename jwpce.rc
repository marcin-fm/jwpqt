/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDI_MAINICON            ICON    PRELOAD DISCARDABLE "mainicon.ico"
IDI_FILEICON            ICON    PRELOAD DISCARDABLE "fileicon.ico"
IDI_ALTICON             ICON    PRELOAD DISCARDABLE "alticon.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDM_POPUP MENU DISCARDABLE 
BEGIN
    POPUP "PopUp"
    BEGIN
        MENUITEM "Cu&t\tCtrl+X/Shift+Del",      IDM_EDIT_CUT
        MENUITEM "&Copy\tCtrl+C/Ctrl+Ins",      IDM_EDIT_COPY
        MENUITEM "&Paste\tCtrl+V/Shift+Ins",    IDM_EDIT_PASTE
        MENUITEM "Select &All\tCtrl+Shift+A",   IDM_EDIT_SELECTALL
        MENUITEM SEPARATOR
        MENUITEM "&Get Info...\tCtrl+I",        IDM_KANJI_GETINFO
        MENUITEM "&Dictionary...\tCtrl+D/F6",   IDM_UTILITIES_DICTIONARY
        MENUITEM "&Radical Lookup...\tCtrl+L/F5", IDM_KANJI_RADICALLOOKUP
        MENUITEM SEPARATOR
        MENUITEM "&Bushu Lookup...\tCtrl+Shift+L", IDM_KANJI_BUSHULOOKUP
        MENUITEM "Str&oke/Bushu Lookup...\tCtrl+Shift+B", 
                                                IDM_KANJI_BUSHU2LOOKUP
        MENUITEM "&SKIP Lookup...\tCtrl+Shift+S", IDM_KANJI_SKIPLOOKUP
        MENUITEM "&Hadamitzky/Spahn Lookup...\tCtrl+H", IDM_KANJI_HSLOOKUP
        MENUITEM "&Four-Corner Lookup...\tCtrl+4", IDM_KANJI_FCLOOKUP
        MENUITEM "Reading &Lookup...\tCtrl+Shift+R", IDM_KANJI_READINGLOOKUP
        MENUITEM "&Index Lookup...\tCtrl+Shift+I", IDM_KANJI_INDEXLOOKUP
        MENUITEM SEPARATOR
        POPUP "&Mode"
        BEGIN
            MENUITEM "&Kanji\tCtrl+K/(F4)",         IDM_EDIT_MODE_KANJI
            MENUITEM "&Ascii\tCtrl+A/(F4)",         IDM_EDIT_MODE_ASCII
            MENUITEM "&Jascii\tCtrl+J",             IDM_EDIT_MODE_JASCII
        END
        MENUITEM "Con&vert\tCtrl+>/F2",         IDM_KANJI_CONVERT
        MENUITEM "&JIS Table...\tCtrl+T",       IDM_KANJI_JISTABLE
        MENUITEM SEPARATOR
        MENUITEM "&Undo\tCtrl+Z",               IDM_EDIT_UNDO
        MENUITEM "R&edo\tCtrl+Y",               IDM_EDIT_REDO
    END
    POPUP "List"
    BEGIN
        MENUITEM "&Copy\tCtrl+C/Ctrl+Ins",      IDM_LIST_COPY
        MENUITEM "&Get Info...",                IDM_LIST_GETINFO
        MENUITEM SEPARATOR
        MENUITEM "Insert to &File\tAlt+I",      IDM_LIST_INSERTTOFILE
        MENUITEM "&Replace to File",            IDM_LIST_REPLACETOFILE
        MENUITEM SEPARATOR
        MENUITEM "Insert to &New File",         IDM_LIST_INSERTTONEWFILE
        MENUITEM "Insert to &Any File...",      IDM_LIST_INSERTTOANYFILE
        MENUITEM "&Insert to",                  IDM_LIST_INSERTTO
    END
    POPUP "Junk"
    BEGIN
        MENUITEM "Toggle Buttons",              IDM_UTILITIES_TOGGLE
    END
END

IDM_MAINMENU MENU DISCARDABLE 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New\tAlt+N",                 IDM_FILE_NEW
        MENUITEM "&Open...\tAlt+O",             IDM_FILE_OPEN
        MENUITEM "&Revert\tAlt+R",              IDM_FILE_REVERT
        MENUITEM "&Close\tAlt+C/Ctrl+F4",       IDM_FILE_CLOSE
        MENUITEM "C&lose All\tAlt+Shift+C",     IDM_FILE_CLOSEALL
        MENUITEM "&Save\tAlt+S",                IDM_FILE_SAVE
        MENUITEM "Sa&ve All\tAlt+V",            IDM_FILE_SAVEALL
        MENUITEM "Save &As...\tAlt+A",          IDM_FILE_SAVEAS
        MENUITEM "&Delete\tAlt+D",              IDM_FILE_DELETE
        MENUITEM SEPARATOR
        MENUITEM "&Print...\tAlt+P",            IDM_FILE_PRINT
        MENUITEM "Pr&inter Setup...",           IDM_FILE_PRINTERSETUP
        MENUITEM SEPARATOR
        POPUP "Recent &Files"
        BEGIN
            MENUITEM "None",                        IDM_FILE_FILES_NONE
        END
        MENUITEM SEPARATOR
        MENUITEM "E&xit\tAlt+X/Alt-F4",         IDM_FILE_EXIT
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "&Undo\tCtrl+Z",               IDM_EDIT_UNDO
        MENUITEM "R&edo\tCtrl+Y",               IDM_EDIT_REDO
        MENUITEM SEPARATOR
        POPUP "&Mode"
        BEGIN
            MENUITEM "&Kanji\tCtrl+K/(F4)/(Alt+^)", IDM_EDIT_MODE_KANJI
            MENUITEM "&Ascii\tCtrl+A/(F4)/(Alt+^)", IDM_EDIT_MODE_ASCII
            MENUITEM "&Jascii\tCtrl+J",             IDM_EDIT_MODE_JASCII
        END
        MENUITEM SEPARATOR
        MENUITEM "Cu&t\tCtrl+X/Shift+Del",      IDM_EDIT_CUT
        MENUITEM "&Copy\tCtrl+C/Ctrl+Ins",      IDM_EDIT_COPY
        MENUITEM "&Paste\tCtrl+V/Shift+Ins",    IDM_EDIT_PASTE
        MENUITEM "Select &All\tCtrl+Shift+A",   IDM_EDIT_SELECTALL
        MENUITEM SEPARATOR
        MENUITEM "Insert Page &Break\tCtrl+Enter", IDM_EDIT_INSERTPAGEBREAK
        MENUITEM SEPARATOR
        MENUITEM "&Search...\tCtrl+F/Ctrl+S/F8", IDM_EDIT_SEARCH
        MENUITEM "&Replace...\tCtrl+R/Shift+F8", IDM_EDIT_REPLACE
        MENUITEM "Find &Next\tCtrl+N/F9",       IDM_EDIT_FINDNEXT
        MENUITEM "Re&verse Search\tCtrl+B/F7",  IDM_EDIT_REVERSESEARCH
    END
    POPUP "&Kanji"
    BEGIN
        MENUITEM "&Convert\tCtrl+>/F2",         IDM_KANJI_CONVERT
        MENUITEM SEPARATOR
        MENUITEM "&Get Info...\tCtrl+I",        IDM_KANJI_GETINFO
        MENUITEM "&Radical Lookup...\tCtrl+L/F5", IDM_KANJI_RADICALLOOKUP
        MENUITEM SEPARATOR
        MENUITEM "&Bushu Lookup...\tCtrl+Shift+L", IDM_KANJI_BUSHULOOKUP
        MENUITEM "Str&oke/Bushu Lookup...\tCtrl+Shift+B", 
                                                IDM_KANJI_BUSHU2LOOKUP
        MENUITEM "&SKIP Lookup...\tCtrl+Shift+S", IDM_KANJI_SKIPLOOKUP
        MENUITEM "&Hadamitzky/Spahn Lookup...\tCtrl+H", IDM_KANJI_HSLOOKUP
        MENUITEM "&Four-Corner Lookup...\tCtrl+4", IDM_KANJI_FCLOOKUP
        MENUITEM "R&eading Lookup...\tCtrl+Shift+R", IDM_KANJI_READINGLOOKUP
        MENUITEM "&Index Lookup...\tCtrl+Shift+I", IDM_KANJI_INDEXLOOKUP
        MENUITEM SEPARATOR
        MENUITEM "JIS &Table...\tCtrl+T",       IDM_KANJI_JISTABLE
        MENUITEM "Count &Kanji...",             IDM_KANJI_COUNTKANJI
        MENUITEM "&Make Kanji List",            IDM_KANJI_MAKEKANJILIST
        MENUITEM "Clear Kanji &List",           IDM_KANJI_CLEARKANJILIST
    END
    POPUP "&Utilities"
    BEGIN
        MENUITEM "Format &File ...\tAlt+Ctrl+F", IDM_UTILITIES_FORMATFILE
        MENUITEM "Format &Paragraph ...\tAlt+Shift+F", 
                                                IDM_UTILITIES_FORMATPARAGRAPH

        MENUITEM "Page &Layout...\tAlt+L",      IDM_UTILITIES_PAGELAYOUT
        MENUITEM SEPARATOR
        MENUITEM "&Dictionary...\tCtrl+D/F6",   IDM_UTILITIES_DICTIONARY
        MENUITEM "&User Conversion...",         IDM_UTILITIES_USERCONVERSION
        MENUITEM SEPARATOR
        MENUITEM "&Options...\tCtrl+O",         IDM_UTILITIES_OPTIONS
        MENUITEM "&Customize...",               IDM_UTILITIES_CUSTOMIZE
        MENUITEM "D&efault Options",            IDM_UTILITIES_DEFAULTOPTIONS
        MENUITEM "&Save Settings",              IDM_UTILITIES_SAVESETTINGS
        MENUITEM SEPARATOR
        MENUITEM "&Install...",                 IDM_UTILITIES_INSTALL
    END
    POPUP "&Window"
    BEGIN
        MENUITEM "&Next File\tCtrl+Tab/Ctrl+PgUp", IDM_WINDOW_NEXTFILE
        MENUITEM "&Previous File\tShift+Tab/Ctrl+PgDn", 
                                                IDM_WINDOW_PREVIOUSFILE
        MENUITEM "&Files...\tAlt+W",            IDM_WINDOW_FILES
        MENUITEM SEPARATOR
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&Main Index...\tF1",          IDM_HELP_MAININDEX
        MENUITEM SEPARATOR
        MENUITEM "&About JWPce...",             IDM_HELP_ABOUTJWPCE
    END
END


