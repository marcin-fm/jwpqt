/////////////////////////////////////////////////////////////////////////////
//
// Bitmap
//

IDB_RADICALS            BITMAP  MOVEABLE PURE   "radicals-ce.bmp"
IDB_STROKES             BITMAP  DISCARDABLE     "strokes.bmp"
IDB_SKIPTYPES           BITMAP  DISCARDABLE     "skiptype.bmp"
IDB_FCSHAPES            BITMAP  DISCARDABLE     "fourcorners.bmp"
IDB_HSRADICALS          BITMAP  DISCARDABLE     "hsradicals-ce.bmp"
IDB_PPCTOOLS            BITMAP  DISCARDABLE     "ppctools.bmp"

/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDI_MAINICON            ICON    PRELOAD DISCARDABLE "mainicon.ico"
IDI_FILEICON            ICON    PRELOAD DISCARDABLE "fileicon.ico"
IDI_ALTICON             ICON    PRELOAD DISCARDABLE "alticon.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDM_POPUP MENU DISCARDABLE 
BEGIN
    POPUP "PopUp"
    BEGIN
        MENUITEM "Cu&t",                        IDM_EDIT_CUT
        MENUITEM "&Copy",                       IDM_EDIT_COPY
        MENUITEM "&Paste",                      IDM_EDIT_PASTE
        MENUITEM SEPARATOR
        MENUITEM "&Get Info...",                IDM_KANJI_GETINFO
        MENUITEM "&Dictionary...",              IDM_UTILITIES_DICTIONARY
        MENUITEM "&Radical Lookup...",          IDM_KANJI_RADICALLOOKUP
        POPUP "M&ore Lookups"
        BEGIN
            MENUITEM "&Bushu Lookup...",            IDM_KANJI_BUSHULOOKUP
            MENUITEM "Str&oke/Bushu Lookup...",     IDM_KANJI_BUSHU2LOOKUP
            MENUITEM "&SKIP Lookup...",             IDM_KANJI_SKIPLOOKUP
            MENUITEM "&Hadamitzky/Spahn Lookup...", IDM_KANJI_HSLOOKUP
            MENUITEM "&Four-Corner Lookup...",      IDM_KANJI_FCLOOKUP
            MENUITEM "R&eading Lookup...",          IDM_KANJI_READINGLOOKUP
            MENUITEM "&Index Lookup...",            IDM_KANJI_INDEXLOOKUP
        END
        MENUITEM SEPARATOR
        POPUP "&Mode"
        BEGIN
            MENUITEM "&Kanji",                      IDM_EDIT_MODE_KANJI
            MENUITEM "&Ascii",                      IDM_EDIT_MODE_ASCII
            MENUITEM "&Jascii",                     IDM_EDIT_MODE_JASCII
        END
        MENUITEM "&Convert",                    IDM_KANJI_CONVERT
        MENUITEM "JIS &Table...",               IDM_KANJI_JISTABLE
        MENUITEM SEPARATOR
        MENUITEM "&Undo",                       IDM_EDIT_UNDO
        MENUITEM "R&edo",                       IDM_EDIT_REDO
    END
    POPUP "List"
    BEGIN
        MENUITEM "&Copy",                       IDM_LIST_COPY
        MENUITEM "&Get Info...",                IDM_LIST_GETINFO
        MENUITEM SEPARATOR
        MENUITEM "Insert to &File",             IDM_LIST_INSERTTOFILE
        MENUITEM "&Replace to File",            IDM_LIST_REPLACETOFILE
        MENUITEM SEPARATOR
        MENUITEM "Insert to &New File",         IDM_LIST_INSERTTONEWFILE
        MENUITEM "Insert to &Any File...",      IDM_LIST_INSERTTOANYFILE
        MENUITEM "&Insert to",                  IDM_LIST_INSERTTO
    END
END

IDM_MAINMENU MENU DISCARDABLE 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New",                        IDM_FILE_NEW
        MENUITEM "&Open...",                    IDM_FILE_OPEN
        MENUITEM "&Revert",                     IDM_FILE_REVERT
        MENUITEM "&Close",                      IDM_FILE_CLOSE
        MENUITEM "C&lose All",                  IDM_FILE_CLOSEALL
        MENUITEM "&Save",                       IDM_FILE_SAVE
        MENUITEM "Sa&ve All",                   IDM_FILE_SAVEALL
        MENUITEM "Save &As...",                 IDM_FILE_SAVEAS
        MENUITEM "&Delete",                     IDM_FILE_DELETE
        MENUITEM SEPARATOR
        POPUP "Recent &Files"
        BEGIN
            MENUITEM "None",                        IDM_FILE_FILES_NONE
        END
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       IDM_FILE_EXIT
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "&Undo",                       IDM_EDIT_UNDO
        MENUITEM "R&edo",                       IDM_EDIT_REDO
        MENUITEM SEPARATOR
        MENUITEM "Cu&t",                        IDM_EDIT_CUT
        MENUITEM "&Copy",                       IDM_EDIT_COPY
        MENUITEM "&Paste",                      IDM_EDIT_PASTE
        MENUITEM "Select &All",                 IDM_EDIT_SELECTALL
        MENUITEM SEPARATOR
        MENUITEM "&Search...",                  IDM_EDIT_SEARCH
        MENUITEM "&Replace...",                 IDM_EDIT_REPLACE
        MENUITEM "Find &Next",                  IDM_EDIT_FINDNEXT
        MENUITEM "R&everse Search",             IDM_EDIT_REVERSESEARCH
    END
    POPUP "&Kan"
    BEGIN
        MENUITEM "&Convert",                    IDM_KANJI_CONVERT
        MENUITEM SEPARATOR
        MENUITEM "&Get Info...",                IDM_KANJI_GETINFO
        MENUITEM "&Radical Lookup...",          IDM_KANJI_RADICALLOOKUP
        MENUITEM SEPARATOR
        MENUITEM "&Bushu Lookup...",            IDM_KANJI_BUSHULOOKUP
        MENUITEM "Str&oke/Bushu Lookup...",     IDM_KANJI_BUSHU2LOOKUP
        MENUITEM "&SKIP Lookup...",             IDM_KANJI_SKIPLOOKUP
        MENUITEM "&Hadamitzky/Spahn Lookup...", IDM_KANJI_HSLOOKUP
        MENUITEM "&Four-Corner Lookup...",      IDM_KANJI_FCLOOKUP
        MENUITEM "R&eading Lookup...",          IDM_KANJI_READINGLOOKUP
        MENUITEM "&Index Lookup...",            IDM_KANJI_INDEXLOOKUP
        MENUITEM SEPARATOR
        MENUITEM "JIS &Table...",               IDM_KANJI_JISTABLE
        MENUITEM "Count &Kanji...",             IDM_KANJI_COUNTKANJI
        MENUITEM "&Make Kanji List",            IDM_KANJI_MAKEKANJILIST
        MENUITEM "Clear Kanji &List",           IDM_KANJI_CLEARKANJILIST
    END
    POPUP "&Util"
    BEGIN
        MENUITEM "Format &File ...",            IDM_UTILITIES_FORMATFILE
        MENUITEM "Format &Paragraph ...",       IDM_UTILITIES_FORMATPARAGRAPH

        MENUITEM "Page &Layout...",             IDM_UTILITIES_PAGELAYOUT
        MENUITEM SEPARATOR
        MENUITEM "&Dictionary...",              IDM_UTILITIES_DICTIONARY
        MENUITEM "&User Conversion...",         IDM_UTILITIES_USERCONVERSION
        MENUITEM SEPARATOR
        MENUITEM "&Options...",                 IDM_UTILITIES_OPTIONS
        MENUITEM "D&efault Options",            IDM_UTILITIES_DEFAULTOPTIONS
        MENUITEM "&Save Settings",              IDM_UTILITIES_SAVESETTINGS
        MENUITEM SEPARATOR
        MENUITEM "&Install...",                 IDM_UTILITIES_INSTALL
    END
    POPUP "&Win"
    BEGIN
        MENUITEM "&Next File",                  IDM_WINDOW_NEXTFILE
        MENUITEM "&Previous File",              IDM_WINDOW_PREVIOUSFILE
        MENUITEM "&Files...",                   IDM_WINDOW_FILES
        MENUITEM SEPARATOR
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&Main Index...",              IDM_HELP_MAININDEX
        MENUITEM SEPARATOR
        MENUITEM "&About JWPce...",             IDM_HELP_ABOUTJWPCE
    END
END


/////////////////////////////////////////////////////////////////////////////
//
// DESIGNINFO
//

#ifdef APSTUDIO_INVOKED
GUIDELINES DESIGNINFO DISCARDABLE 
BEGIN
    IDD_REPLACECONFIRM, DIALOG
    BEGIN
        BOTTOMMARGIN, 57
    END

    IDD_KANJIINFO, DIALOG
    BEGIN
        BOTTOMMARGIN, 159
    END

    IDD_FORMATPARA, DIALOG
    BEGIN
        RIGHTMARGIN, 133
        BOTTOMMARGIN, 65
    END

    IDD_DICTOPTIONS, DIALOG
    BEGIN
        BOTTOMMARGIN, 131
    END

    IDD_DICTIONARY, DIALOG
    BEGIN
        RIGHTMARGIN, 146
