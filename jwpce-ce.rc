    IDS_ERROR_TERMINAL      "JWPce TERMINAL ERROR!"
    IDS_FP_FORMATFILE       "Format File"
    IDS_FP_INVALIDTEXT      "Invalid indent!\n\nIndented paragraph must fit on page."
    IDS_FP_INVALIDTITLE     "Formatting Error"
    IDS_ERROR               "JWPce ERROR!"
    IDS_WARNING             "JWPce Warning!"
    IDS_ERROR_MEMORY        "Out of Memory!"
    IDS_AREYOUSURE          "Are You Sure?"
    IDS_CK_TEXT             "Color kanji list built, %d kanji extracted."
    IDS_CK_TITLE            "Color Kanji List Built"
    IDS_CK_ERROR            "Cannot save color-kanji list\n\n%s."
