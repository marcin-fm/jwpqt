#include <windows.h>

IDI_JWPQT ICON "@PROJECT_SOURCE_DIR@/packaging/jwpqt.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "jwpqt contributors\0"
      VALUE "FileDescription", "JWPqt Japanese word processor\0"
      VALUE "FileVersion", "@JWPQT_RELEASE_VERSION@\0"
      VALUE "InternalName", "jwpqt\0"
      VALUE "LegalCopyright", "GPL-2.0-or-later; see bundled notices\0"
      VALUE "OriginalFilename", "jwpqt.exe\0"
      VALUE "ProductName", "JWPqt\0"
      VALUE "ProductVersion", "@JWPQT_RELEASE_VERSION@\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
